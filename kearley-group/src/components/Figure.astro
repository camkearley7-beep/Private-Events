---
/**
 * Responsive image with a quiet tonal fallback.
 * Unsplash URLs automatically receive a responsive srcset.
 */
interface Props {
  src?: string;
  alt: string;
  focus?: string;
  /** CSS aspect-ratio, e.g. '4 / 5'. Omit to let the parent size it. */
  ratio?: string;
  sizes?: string;
  tone?: string;
  class?: string;
  reveal?: boolean;
  delay?: number;
  parallax?: number;
  eager?: boolean;
}

const {
  src,
  alt,
  focus = 'center',
  ratio,
  sizes = '100vw',
  tone,
  class: className = '',
  reveal = true,
  delay = 0,
  parallax,
  eager = false,
} = Astro.props;

const widths = [640, 960, 1280, 1680, 2200];
const isUnsplash = src?.includes('images.unsplash.com');
const build = (w: number) => `${src}?auto=format&fit=crop&w=${w}&q=72`;
const srcset = isUnsplash ? widths.map((w) => `${build(w)} ${w}w`).join(', ') : undefined;
const finalSrc = isUnsplash ? build(1680) : src;

const style = [
  ratio ? `aspect-ratio:${ratio}` : '',
  tone ? `--fig-tone:${tone}` : '',
  delay ? `--delay:${delay}s` : '',
]
  .filter(Boolean)
  .join(';');
---

<figure class:list={['fig', className, { 'is-missing': !src }]} style={style} data-reveal={reveal ? '' : undefined}>
  {
    src && (
      <img
        src={finalSrc}
        srcset={srcset}
        sizes={sizes}
        alt={alt}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : undefined}
        decoding="async"
        style={`object-position:${focus}`}
        data-parallax-img={parallax}
        onerror="this.parentElement.classList.add('is-missing')"
      />
    )
  }
  <span class="fig__fallback label" aria-hidden="true">Photography forthcoming</span>
</figure>
