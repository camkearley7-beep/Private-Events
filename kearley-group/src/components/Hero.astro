---
import Figure from './Figure.astro';
import Lines from './Lines.astro';
import { site } from '../data/site';
import { companies } from '../data/companies';

const count = String(companies.length).padStart(2, '0');
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="hero__inner wrap">
    <div class="hero__meta label" data-hero-meta>
      <span>A Private Holding Group</span>
      <span class="hero__meta-mid">{count} Independent Companies</span>
      {site.contact.location && <span>{site.contact.location}</span>}
    </div>

    <h1 class="hero__mast serif" id="hero-title">
      <span class="hero__mast-k" data-hero-mast>
        {'Kearley'.split('').map((ch, i) => (
          <span class="hero__char" style={`--c:${i}`} aria-hidden="true">{ch}</span>
        ))}
        <span class="sr-only">Kearley Group</span>
      </span>
      <span class="hero__mast-g label" aria-hidden="true">Group</span>
    </h1>

    <div class="hero__media" data-hero-media>
      <Figure
        src="https://images.unsplash.com/photo-1487958449943-2429e8be8625"
        alt="Abstract white architecture against a clear sky"
        focus="center 45%"
        tone="#dcd5c8"
        sizes="(min-width: 1680px) 1600px, 100vw"
        reveal={false}
        eager
        parallax={0.12}
      />
    </div>

    <div class="hero__foot">
      <p class="hero__headline serif" data-lines data-hero-lines>
        <Lines lines={site.hero.headline} italic={[1]} />
      </p>
      <div class="hero__aside" data-hero-aside>
        <p class="hero__standfirst">{site.hero.standfirst}</p>
        <a href="#the-group" class="hero__scroll label">
          <span>Begin</span>
          <span class="hero__scroll-line" aria-hidden="true"></span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: 4.5rem;
    background: var(--ivory);
  }
  .hero__inner {
    display: grid;
    grid-template-rows: auto auto minmax(14rem, 1fr) auto;
    min-height: 100svh;
    min-height: calc(100svh - 4.5rem);
    padding-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }

  .hero__meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1rem;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    color: var(--muted);
  }

  /* Masthead — sized to span the measure exactly */
  .hero__mast {
    position: relative;
    margin: 0;
    padding-top: clamp(0.75rem, 1.5vw, 1.5rem);
    line-height: 0.8;
    font-weight: 400;
    text-transform: uppercase;

  }
  .hero__mast-k {
    display: flex;
    justify-content: space-between;
    font-size: min(19.2vw, 20rem);
    letter-spacing: 0;
  }
  .hero__char { display: inline-block; }
  .hero__mast-g {
    position: absolute;
    right: 0.2em;
    bottom: -1.9em;
    font-size: clamp(0.625rem, 0.5rem + 0.4vw, 0.875rem);
    letter-spacing: 0.9em;
    margin-right: -0.9em;
    color: var(--charcoal);
  }

  .hero__media {
    position: relative;
    margin-top: clamp(2.25rem, 4vw, 3.5rem);
    min-height: 14rem;
  }
  .hero__media :global(.fig) { position: absolute; inset: 0; }
  .hero__media :global(img) { height: 115%; margin-top: -7.5%; }

  .hero__foot {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 2rem;
    align-items: end;
    padding-top: clamp(1.5rem, 3vw, 2.5rem);
  }
  .hero__headline {
    grid-column: 1 / span 8;
    font-size: clamp(2.1rem, 1rem + 4.2vw, 5.75rem);
    line-height: 0.98;
    letter-spacing: -0.015em;

  }
  .hero__aside {
    grid-column: 9 / -1;
    display: grid;
    gap: 1.75rem;
    justify-items: start;
    padding-bottom: 0.4rem;
  }
  .hero__standfirst { max-width: 30ch; color: var(--ink); font-size: 0.9375rem; line-height: 1.6; }
  .hero__scroll { display: inline-flex; align-items: center; gap: 1rem; padding-block: 0.5rem; }
  .hero__scroll-line { position: relative; width: 3.5rem; height: 1px; background: var(--rule-strong); overflow: hidden; }
  .hero__scroll-line::after {
    content: '';
    position: absolute; inset: 0;
    background: var(--charcoal);
    transform: translateX(-100%);
    animation: hero-scroll 2.8s var(--ease-in-out) 2s infinite;
  }
  @keyframes hero-scroll {
    0% { transform: translateX(-100%); }
    50% { transform: translateX(0); }
    100% { transform: translateX(100%); }
  }

  /* ---- Opening choreography ---- */
  :global(.js) .hero__char {
    opacity: 0;
    transform: translate3d(0, 0.18em, 0);
    filter: blur(6px);
    transition: opacity 1.4s var(--ease), transform 1.6s var(--ease), filter 1.4s var(--ease);
    transition-delay: calc(0.15s + var(--c) * 0.06s);
  }
  :global(.js) .hero__mast-g,
  :global(.js) .hero__meta,
  :global(.js) .hero__aside {
    opacity: 0;
    transition: opacity 1.4s var(--ease) 1.1s;
  }
  :global(.js) .hero__media {
    clip-path: inset(0 50% 0 50%);
    transition: clip-path 1.8s var(--ease-in-out) 0.55s;
  }
  :global(.js) .hero__media :global(.fig img) { transform: scale(1.12); transition: transform 3.2s var(--ease) 0.55s; }

  :global(.is-loaded) .hero__char { opacity: 1; transform: none; filter: none; }
  :global(.is-loaded) .hero__mast-g,
  :global(.is-loaded) .hero__meta,
  :global(.is-loaded) .hero__aside { opacity: 1; }
  :global(.is-loaded) .hero__media { clip-path: inset(0 0 0 0); }
  :global(.is-loaded) .hero__media :global(.fig img) { transform: scale(1); }

  @media (max-width: 860px) {
    .hero__meta-mid { display: none; }
    .hero__inner { grid-template-rows: auto auto minmax(16rem, 1fr) auto; }
    .hero__foot { display: block; }
    .hero__headline { font-size: clamp(2.4rem, 11vw, 3.6rem); }
    .hero__aside { margin-top: 1.75rem; grid-template-columns: 1fr auto; align-items: end; gap: 1.5rem; }
    .hero__standfirst { font-size: 0.875rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .hero__char,
    :global(.js) .hero__mast-g,
    :global(.js) .hero__meta,
    :global(.js) .hero__aside { opacity: 1; transform: none; filter: none; }
    :global(.js) .hero__media { clip-path: none; }
    .hero__scroll-line::after { animation: none; }
  }
</style>
