---
import type { Company } from '../../data/companies';
import Figure from '../Figure.astro';
import Folio from './Folio.astro';
import Logo from './Logo.astro';
import Explore from './Explore.astro';
interface Props { company: Company; index: number; total: number; }
const { company: c, index, total } = Astro.props;
const [first, second] = c.displayName ?? [c.name, ''];
---
<article class="f-min" id={c.slug} aria-label={c.name}>
  <div class="wrap">
    <Folio index={index} total={total} sector={c.sector} />
    <h3 class="f-min__title serif">
      <span class="f-min__word f-min__word--a" data-reveal>{first}</span>
      <span class="f-min__img">
        <Figure {...c.image} alt={c.image?.alt ?? ''} ratio="3 / 4" tone="#d6cfc1" sizes="(min-width: 960px) 20vw, 50vw" delay={0.1} />
      </span>
      {second && <span class="f-min__word f-min__word--b" data-reveal style="--delay:.15s"><em>{second}</em></span>}
    </h3>
    <div class="f-min__foot" data-reveal>
      <Logo company={c} />
      <p class="f-min__desc">{c.description}</p>
      <Explore company={c} />
    </div>
  </div>
</article>
<style>
  .f-min { background: var(--stone); padding-block: clamp(4rem, 8vw, 8rem) var(--section); }
  .f-min__title {
    margin-top: clamp(4rem, 9vw, 9rem);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: clamp(1rem, 3vw, 3rem);
    font-size: clamp(3rem, 1rem + 8vw, 10.5rem);
    line-height: 0.9;
    letter-spacing: -0.03em;
    font-weight: 400;

  }
  .f-min__word--a { justify-self: end; }
  .f-min__word--b { justify-self: start; }
  .f-min__img { width: clamp(9rem, 17vw, 17rem); }
  .f-min__foot {
    margin: clamp(3.5rem, 7vw, 6.5rem) auto 0;
    max-width: 30rem;
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 1.5rem;
  }
  .f-min__desc { color: var(--ink); }
  @media (max-width: 720px) {
    .f-min__title { grid-template-columns: 1fr; gap: 1.25rem; font-size: clamp(3.75rem, 20vw, 6rem); }
    .f-min__word--a { justify-self: start; }
    .f-min__word--b { justify-self: end; }
    .f-min__img { width: 58%; justify-self: center; }
  }
</style>
