---
/**
 * The KEARLEY GROUP wordmark.
 * A wide-set Didone "KEARLEY" over a hairline, with "GROUP" in spaced grotesk.
 */
interface Props { size?: 'sm' | 'md'; class?: string; }
const { size = 'sm', class: className = '' } = Astro.props;
---

<span class:list={['wordmark', `wordmark--${size}`, className]}>
  <span class="wordmark__k serif">Kearley</span>
  <span class="wordmark__rule" aria-hidden="true"></span>
  <span class="wordmark__g">Group</span>
</span>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.7em;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .wordmark__k {
    font-size: 1.15em;
    letter-spacing: 0.24em;
    margin-right: -0.24em;
    font-weight: 500;

  }
  .wordmark__rule {
    width: 1.6em;
    height: 1px;
    background: currentColor;
    opacity: 0.55;
  }
  .wordmark__g {
    font-family: var(--sans);
    font-size: 0.62em;
    font-weight: 500;
    letter-spacing: 0.42em;
    margin-right: -0.42em;
  }
  .wordmark--sm { font-size: 0.9375rem; }
  .wordmark--md { font-size: 1.25rem; }
</style>
